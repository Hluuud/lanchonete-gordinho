# Supabase — Painel do projeto > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo server-only — NUNCA commitar, NUNCA expor no client
SUPABASE_SERVICE_ROLE_KEY=

# Tenant padrão da loja (Fase 0: um único restaurante)
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=gordinho

# Sentry (Sprint 5.5) — DSN do projeto em sentry.io, seguro para expor ao client
NEXT_PUBLIC_SENTRY_DSN=

# Upstash Redis (Sprint 5.5, Fase 2) — REST API do banco Redis, usado para rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
